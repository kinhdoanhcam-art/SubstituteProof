# Contract address on GenLayer Studio Next. The address below is also the
# built-in default in src/config.ts, so the app works without this variable.
VITE_CONTRACT_ADDRESS=0x2E07cA0D78D3Ec9D0AFa67b82df5E0570F816C78

# Network. All four have working defaults for Studio Next; override only to move
# the app to a different endpoint.
VITE_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
VITE_GENLAYER_CHAIN_ID=61997
VITE_GENLAYER_CHAIN_NAME=GenLayer Studio Next
VITE_GENLAYER_SYMBOL=GEN
VITE_EXPLORER_URL=https://explorer-studio-next.genlayer.com

# Runtime evidence. Fill these ONLY from a run executed against the contract
# above. Blank is honest; a value from another deployment is not.
VITE_RUNTIME_AGREEMENT_ID=
VITE_CONTRACT_SHA256=
